{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the existing Worker so deploys land on the same script and
  // keep whatever routes and custom domains are already attached to it.
  "name": "clinician--marketing",
  "compatibility_date": "2025-09-23",
  // Static export output. With no "main", this deploys as a pure
  // static-assets Worker: Cloudflare serves the files from its edge and
  // no script is invoked on a page request.
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  },
  // Keep the *.workers.dev URL alive alongside the custom domains. Adding
  // `routes` disables it by default, which takes the site offline on that
  // hostname — useful as a fallback and for testing before DNS resolves.
  "workers_dev": true,
  "preview_urls": true,
  // Declared here so a deploy re-creates them if they are ever removed,
  // and so CI deploys keep the custom domains attached.
  "routes": [
    { "pattern": "clinician.marketing", "custom_domain": true },
    { "pattern": "www.clinician.marketing", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
