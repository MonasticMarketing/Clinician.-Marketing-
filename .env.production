# Build-time only. NEXT_PUBLIC_* values are inlined by Next during the
# build, so they cannot be set as Worker runtime variables — they have to
# be present when `next build` runs. Committed so local and CI builds
# produce the same canonical URLs, sitemap and JSON-LD.
#
# Secrets do NOT belong here. RESEND_API_KEY, CONTACT_TO_EMAIL and
# CONTACT_FROM_EMAIL are read at runtime and are set on the Worker.
NEXT_PUBLIC_SITE_URL=https://clinician.marketing
