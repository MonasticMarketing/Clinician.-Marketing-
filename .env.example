# Canonical origin — used for metadata, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://clinician.marketing

# Contact form delivery (Resend). Without these the endpoint accepts the
# submission and logs a warning instead of emailing it.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Analytics. Leave blank to emit no tracking script at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
